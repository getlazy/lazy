node_modules/

# Build files
lazy
lazy-agent

# Lazy storage - we WANT to track these files in git
# .lazy/tasks/ contains the file-based storage (JSON files)
# .lazy/version.json tracks the storage schema version

# But we DON'T want to track these:
.lazy-task-sandbox/
# Per-worktree session lock (src/utils/lock.ts). Never tracked: a tracked lock
# makes every worktree that releases it show a spurious `D .lazy-lock`.
.lazy-lock
.lazy/worktrees/
.lazy/bin/
.lazy/logs/
.lazy/recovery/
.lazy/tasks/*.tmp.*
.lazy/tasks/*.backup.*
.lazy/tasks/*/protocol/
.lazy/storage.lock
.lazy/tmp

# Bun build temporary files
*.bun-build

# Generated version file (from scripts/generate-version.ts)
src/version.ts

# Generated build-info file (from scripts/generate-version.ts / scripts/build.ts)
src/build-info.ts

# Generated prompt bundle (from scripts/generate-prompt-bundle.ts)
src/prompts-bundle.ts

dist/

.DS_Store
.env
.lazy/tasks/*/*.tmp.*
.lazy/tasks/*/*.backup.*
.lazy/.reconcile-lock
.lazy
