# lazy.toml template for v0.11 QA testing with the qa-agent.
#
# Copy this to your test project as lazy.toml.
# Set the QA_SCENARIO_FILE env var to point to your scenario JSON file.
#
# Usage:
#   cp test/qa/lazy.toml.template /tmp/test-project/lazy.toml
#   export QA_SCENARIO_FILE=/path/to/v011-daemon.scenarios.json

[agent]
agent_id = "qa-agent"
# The qa-agent reads its scenario file from the QA_SCENARIO_FILE env var.
# The test driver sets this automatically during setup.

[runner]
# qa-agent runs directly on the host — no Docker needed.
type = "dangerously-host-process-without-any-isolation"

[models]
# Model selection is irrelevant for qa-agent (it uses canned responses),
# but we set a default to avoid validation errors.
default = "journeyman"

[daemon]
# Enable daemon auto-react features for v0.11 testing.
auto_react_ci = true
auto_react_comments = true

[storage]
# Storage backend — external is the default.
# external_path is set dynamically by the QA test driver after copying this template.
backend = "external"

[session]
verbose = false
debug = true
