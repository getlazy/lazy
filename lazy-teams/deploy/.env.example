# Copy to `.env` and edit. `bootstrap.sh` creates a working `.env` for you.

# ── Required ─────────────────────────────────────────────────────────────────

# Public hostname for this install. Used in invitation and password-reset links
# when email is configured, as the TLS certificate name when the `tls` compose
# profile is enabled, and as the only Host header the app answers to (plus
# localhost and 127.0.0.1). Getting this wrong makes the app refuse requests
# with "Blocked host" rather than serve them.
APP_HOST=teams.example.com

# Rails session/cookie signing. Generate with: openssl rand -hex 64
SECRET_KEY_BASE=

# Active Record encryption for daemon tokens, forge credentials, and API keys.
# Generate with: docker compose run --rm app bin/rails db:encryption:init
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# ── Published image (pull-and-go) ────────────────────────────────────────────
# Pin a release with LAZY_TEAMS_TAG (e.g. v0.23.1141). `latest` tracks the
# most recent release publish. Override LAZY_TEAMS_IMAGE for a private registry.

# LAZY_TEAMS_TAG=latest
# LAZY_TEAMS_IMAGE=ghcr.io/getlazy/lazy-teams:latest

# ── Optional: TLS (docker compose --profile tls) ─────────────────────────────

# Email for Let's Encrypt expiry notices. Leave empty to use Caddy's default.
ACME_EMAIL=

HTTP_PORT=80
HTTPS_PORT=443

# Direct HTTP port when not using the tls profile (default 3000).
APP_DIRECT_PORT=3000

# Which interface that direct port is published on. The default is the loopback
# interface, so the port is reachable from this host and nothing else: it
# carries plain HTTP, and the session cookie identifying an administrator
# crosses it in the clear.
#
# Reach it from another machine with an SSH tunnel:
#
#   ssh -L 3000:127.0.0.1:3000 you@this-host
#
# Set this to 0.0.0.0 only when something in front of it terminates TLS.
# APP_DIRECT_BIND=127.0.0.1

# ── Optional: TLS posture ────────────────────────────────────────────────────
# Defaults suit both the bundled `tls` profile and any reverse proxy in front,
# including ones that send no forwarded-proto header (Tailscale serve,
# Cloudflare Tunnel). Leave them alone unless the app is genuinely served over
# plain HTTP.

# Redirect HTTP to HTTPS, mark cookies `secure`, and send HSTS. Default: true.
# Set to false ONLY for an install reached over plain HTTP — a loopback quick
# start, or an internal network with no TLS anywhere. On a public install this
# is what keeps the admin session cookie off the wire.
# FORCE_SSL=false

# Treat incoming requests as already-encrypted. Defaults to FORCE_SSL, which is
# what a terminator that sends no X-Forwarded-Proto needs; without it such a
# deployment redirect-loops. Set to false only if you terminate TLS at the app
# itself, which this bundle does not do.
# ASSUME_SSL=true

# Scheme used in emailed links. Defaults to https when FORCE_SSL is on and http
# when it is off; set it only when neither is what your edge serves.
# APP_PROTOCOL=https

# Extra hostnames this install answers to, comma-separated. APP_HOST, localhost
# and 127.0.0.1 are always allowed. Needed for a second public name, or a
# health check that arrives with an internal Host header.
# ALLOWED_HOSTS=teams.internal,10.0.0.5

# ── Where data lives ─────────────────────────────────────────────────────────
# COMPOSE INSTALLS: put the fleet root on THIS machine's filesystem.
#
# An absolute host path here bind-mounts it as the container's /var/lib/lazy-fleet,
# so every project's store sits in a directory you can back up, inspect and hand
# to `lazy:adopt_store`. Left unset, the fleet lives in the `lazy_teams_fleet`
# named volume — on Docker Desktop that is inside the Linux VM, reachable only
# from a container. It is the only reason to touch this section on a compose
# install; LAZY_FLEET_ROOT below stays as the image sets it.
#
# Create the directory first, and make it writable by the app container's user.
# A bind mount follows the host PATH: never move or re-create this directory
# under a running install — stop the stack, move it, repoint this, start again.
# LAZY_FLEET_HOST_PATH=/Users/you/lazy-fleet
#
# The compose bundle sets LAZY_FLEET_ROOT and pins LAZY_TEAMS_STORAGE_DIR to the
# `storage/` directory backed by its database volume. Leave those container paths
# alone. Setting LAZY_TEAMS_STORAGE_DIR for a compose install — for example in a
# compose override — moves all four databases out of that volume, so a container
# replacement can lose the install. These settings are here for a NATIVE install
# (macOS, no image: see public-docs/self-hosting-lazy-teams.md), where this file
# is the whole of what an operator loads into their shell and these are paths
# they pick.
#
# Every project's task history, clones and install-hosted repositories. Back this
# up. Defaults to ~/Library/Application Support/lazy-fleet on macOS.
# LAZY_FLEET_ROOT=/Users/you/lazy-fleet

# Where the app's own four sqlite databases go. Defaults to `storage/` beside the
# app — which on a native install is inside the git checkout, so point it at the
# fleet root instead and keep everything the install owns in one place. An empty
# value means unset, not "the filesystem root". Absolute paths only.
# LAZY_TEAMS_STORAGE_DIR=/Users/you/lazy-fleet/app-data

# ── Agent turns: one microVM per project ────────────────────────────────────
#
# The default fleet backend is `smolvm`: each project, and its agent turns, runs
# in its own microVM. The compose image ships smolvm vendored and needs /dev/kvm
# (docker-compose.yml passes it in). With no KVM, bootstrap.sh writes a
# COMPOSE_FILE line selecting docker-compose.local-backend.yml, which is the
# escape hatch: everything except agent turns.
# LAZY_FLEET_BACKEND=local
#
# The image each project's microVM boots. The published Lazy Teams image
# defaults it to ghcr.io/getlazy/lazy-daemon at the Teams image's own version
# tag. Set it only for a native install or a local build: a registry reference
# at the tag matching your checkout, or a local tag or tar from
# scripts/publish-lazy-daemon-image.sh.
# LAZY_DAEMON_IMAGE=ghcr.io/getlazy/lazy-daemon:v0.22.1234
#
# NATIVE installs only (the image sets this): the absolute path
# bin/vendor-smolvm prints. Never a bare `smolvm` from PATH.
# LAZY_SMOLVM_BINARY=/Users/you/lazy-dev/lazy-teams/vendor/smolvm/smolvm

# ── Optional: outgoing email ─────────────────────────────────────────────────
# Without these, the app boots fine and simply does not send mail.

# SMTP_ADDRESS=
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=
# MAILER_FROM=no-reply@example.com

# ── Advanced ─────────────────────────────────────────────────────────────────

# RAILS_LOG_LEVEL=info
