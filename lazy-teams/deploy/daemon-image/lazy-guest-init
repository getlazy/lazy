#!/bin/sh
#
# lazy-guest-init — the image's STABLE SHIM for the guest preparation script.
#
# The script itself (port forwarder, docker data-root, dockerd and its watchdog)
# is lazy's own logic and travels with the lazy binary: it is embedded in
# /opt/lazy/bin/lazy (src/guest/lazy-guest-init in the repository), and an
# in-place upgrade that swaps the binary upgrades it too. This shim only asks
# the CURRENT binary to write its copy out (to the run dir, named by its hash)
# and runs it with the same arguments. Keep it this small: any change to this
# file is a change to the image and needs a new guest ABI, which replaces every
# machine (docs/design/lazy-daemon-image.md, "What travels with the binary").
#
#   LAZY_BIN=<path>   the lazy binary to ask (default /opt/lazy/bin/lazy)

set -eu

LAZY_BINARY="${LAZY_BIN:-/opt/lazy/bin/lazy}"

if ! script="$("$LAZY_BINARY" system guest-init-script)"; then
  echo "lazy-guest-init: ${LAZY_BINARY} could not write out its guest preparation script \
(\`${LAZY_BINARY} system guest-init-script\` failed; its error is above)" >&2
  echo "ready=no"
  echo "reason=guest-init-unavailable"
  exit 1
fi

exec sh "$script" "$@"
