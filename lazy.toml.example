# lazy.toml - Configuration for lazy
# Override the config filename with the LAZY_CONFIG environment variable
# (e.g., LAZY_CONFIG=lazy.lima.toml lazy list)

[models]
# Default model for sessions
# Options: "sonnet", "opus", "haiku"
default = "sonnet"

# Per-role model targets (optional). Route the interactive builder and task
# agents to different backends — backend = "anthropic" | "ollama" | "proxy".
# All three are Anthropic-native; lazy never translates between API shapes.
# When set, these override the legacy [ollama] block below for that role.
#   - ollama/proxy require `model`; proxy also requires `endpoint`.
#   - ollama defaults `endpoint` to http://host.docker.internal:11434.
# Lazy preflights each backend before launch and fails with an actionable
# error if it is unreachable — it never silently falls back to another backend.
# Example: keep the builder on real Anthropic, run agents on a local Ollama model.
#
# [models.roles.builder]
# backend = "anthropic"
# model = "claude-opus-4-8"
#
# [models.roles.agent]
# backend = "ollama"
# model = "qwen3.5:35b-a3b-coding-nvfp4"
# endpoint = "http://host.docker.internal:11434"

[session]
# Show Docker output in real-time during session execution
verbose = false

# Extra logging for troubleshooting
debug = false

# Include commit guidelines in prompts sent to the agent
auto_commit_instructions = true

[data]
# Location of the .lazy directory
path = ".lazy"

[storage]
# Storage backend (default: "external")
backend = "external"
# Path for external storage
# Defaults to ~/.lazy/<project-name> if empty
external_path = ""

[git]
# Default prefix for lazy branches (e.g., "lazy/abc123")
default_branch_prefix = "lazy"

[output]
# Length of shortened IDs displayed in output
shortid_length = 8

[agent]
# Default agent for task execution (default: "claude-code")
agent_id = "claude-code"

# Watchdog timeout for detecting hung agent processes (milliseconds)
# Default: 7200000 (2 hours) — kills agent if no output for that duration
# Set to 0 to disable, or override with a different timeout
# watchdog_output_timeout_ms = 7200000

# Reasoning effort level passed to Claude Code via --effort for task agents.
# Higher levels spend more tokens thinking before responding.
# Valid levels: "low", "medium", "high", "xhigh", "max" (default: "medium")
# effort = "medium"

[builder]
# Reasoning effort level passed to Claude Code via --effort for builder sessions
# (i.e., `lazy builder`). Builder sessions default to "high" because they handle
# orchestration and planning which benefit from more thinking.
# Valid levels: "low", "medium", "high", "xhigh", "max" (default: "high")
# effort = "high"

[chattiness]
# Conversational verbosity baseline for the builder and task agents — how much
# they narrate, explain, and elaborate in their replies. This is separate from
# `effort` (how hard they *think*); chattiness only shapes how much they *say*.
# Levels form a named ladder from least to most verbose:
#   "terse"  — minimal narration, just the essentials
#   "normal" — balanced explanation
#   "chatty" — fuller narration and context
# The configured level is a baseline, not a ceiling: an in-conversation "tell me
# more" / "be terser" nudges one rung for that one reply rather than jumping to
# an extreme.
#
# Set a shared `default` for both roles, and optionally override per role with
# `builder` / `agent` (an override wins over `default` for that role).
#
# Unset by default — when a role's level is unset, no verbosity snippet is
# injected and behavior is unchanged, so existing users see no difference.
# Invalid values fail loudly, naming the offending key and the valid levels.
#
# default = "normal"   # shared baseline for builder and agents
# builder = "chatty"   # override just the builder
# agent = "terse"      # override just the task agents

[server]
# Default port for the web dashboard server
port = 26024
# Interval in seconds for background sync when running lazy server (0 to disable)
# sync_interval = 60

[runner]
# Runner type: "docker" (default) or "dangerously-host-process-without-any-isolation"
# Docker mode runs agents in isolated containers. Host-process mode runs agents
# directly on the host — use **only** in VMs or other already-isolated environments.
type = "docker"

[remote]
# Remote driver: "local" (default), "github", or "gitlab"
driver = "local"
# Git remote name (default: "origin"). Change if your remote is named differently.
# git_remote = "origin"
# When using the GitHub driver, these options are also available:
# github_auto_push = true   # Automatically push after each agent turn
# github_dangerously_sync_comments_in_public_repos_and_open_yourself_to_prompt_injection = false
# Authentication is handled by gh CLI (run: gh auth login)
# When using the GitLab driver, these options are also available:
# gitlab_auto_push = true   # Automatically push after each agent turn
# gitlab_dangerously_sync_comments_in_public_repos_and_open_yourself_to_prompt_injection = false
# Authentication is handled by glab CLI (run: glab auth login)

[docker]
# Auto-detected or manually set toolchain (e.g., "node", "rust", "ruby-rails")
# Determines which built-in Dockerfile to use for agent containers.
# See available toolchains: base, bun, node, deno, rust, go, cpp, ruby-rails,
# ruby-rails-rust, dotnet, python, python-ml, java, kotlin, swift
toolchain = ""
# Path to custom Dockerfile (relative to project root, empty = use built-in default)
# When set, overrides the toolchain Dockerfile.
dockerfile = ""

[documents]
# Path to a directory of documents to mount into the agent container
# path = ""

[features]
# Enable experimental features. Set individual flags or use all = true.
# Use LAZY_VANILLA=1 env var to disable all flags temporarily.
# auto_sync_after_turn = true  # Sync task branch with upstream after each agent turn
# all = true

[worktree]
# Untracked files to copy into new task worktrees (glob patterns)
# Example: include = [".env", ".env.local", "config/local.yml"]
# include = []

# Custom mounts injected into task agent containers (the worktree containers
# where agents run). Array of tables — each entry is a bind mount or a volume.
# Opt-in: none by default. Supported placeholders in source/target, expanded at
# launch: {worktree} → the task's worktree path, {repo} → the repo root.
# Invalid entries fail loudly at load time (missing target, unknown type, a bind
# with no source, a volume that sets source) — never silently skipped.
#
# Bind a host path into the container (source may be absolute or project-relative):
# [[mounts]]
# source = "/abs/or/project-relative/host/path"
# target = "/absolute/container/path"
# readonly = false   # optional, default false
#
# Shadow a worktree path with a container-local volume — the node_modules case.
# The worktree (incl. node_modules) is bind-mounted into the container; a volume
# at {worktree}/node_modules holds the container's Linux binaries so they never
# clobber the host's macOS ones (Docker resolves overlapping mounts by longest
# container-path match, so the inner volume wins). Omit `name` for an anonymous
# volume; set it to reuse/persist a named volume across runs.
# [[mounts]]
# type = "volume"
# name = "myproj-node-modules"   # optional → named; omit → anonymous
# target = "{worktree}/node_modules"

[permissions]
# Glob patterns for files agents are NOT allowed to delete or modify.
# They are allowed to *add* into existing files *and* matching globs.
# Violations are detected after each agent turn and flagged for review.
# Example: protected = ["*.test.ts", "*.spec.ts", "src/core/**", "CLAUDE.md"]
protected = ["README.md", "test/**/*.ts"]

[automation]
# Maintained files — the inverse of [permissions].protected. Patterns agents are
# *expected* to keep up to date as they work (docs, CHANGELOG, architecture).
# When a turn's commits touch none of an entry's files, the supervisor prompts
# the agent once to update them or record why it skipped, before the task blocks
# for review. A nudge, not a gate. Opt-in: empty by default.
# Each entry needs title, pattern, and instructions.
#
# [[automation.maintain]]
# title = "docs"
# pattern = "docs/**/*"
# instructions = "Update any docs that have gone out of date due to your work, OR create new docs if needed."
#
# [[automation.maintain]]
# title = "changelog"
# pattern = "CHANGELOG.md"
# instructions = "Add ONE line to the next release section under Added/Changed/Fixed: bold feature/command name, one sentence of the user-visible effect (not the implementation, no internal type/function names), and your task code in parens as the depth pointer. Max ~25 words. Skip if your work is intra-release; update your existing line instead of adding a second."

[checks]
# Command to run after each agent turn. Output is captured and attached to
# the turn for reviewers to see. Does NOT block the agent or trigger retries.
# post_turn = "bun test --bail"
post_turn = "echo all-good >&2"
# Timeout in seconds for the post_turn command (default: 300 = 5 minutes).
# If the command exceeds this, it is killed and recorded as exit code -2.
post_turn_timeout = 300

[ollama]
# Legacy local-model config. Kept for backward compatibility: when enabled it
# maps to "all roles -> ollama" (both the builder and task agents). For finer
# control — e.g. builder on Anthropic, agents on Ollama — prefer the per-role
# [models.roles.*] tables above, which override this block for any role they set.
# enabled = true
# model = "qwen3.5:35b-a3b-coding-nvfp4"
# endpoint defaults to http://host.docker.internal:11434 if omitted